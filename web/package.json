{
  "name": "cornerstone-payroll-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run src",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gate": "./scripts/gate.sh",
    "test:e2e": "playwright test --project=public",
    "test:e2e:public": "playwright test --project=public",
    "test:e2e:release": "E2E_RELEASE_LANE=true playwright test --project=gate0-release"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.1",
    "@rails/actioncable": "^8.1.300",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.1",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.12.0",
    "posthog-js": "^1.364.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.10",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  }
}
