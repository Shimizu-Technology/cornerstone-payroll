# Non-secret runtime settings. Secrets live in the macOS login keychain.
PAYROLL_IMAGE_TAG=staging-v2
AIRE_IMAGE_TAG=staging-v2
STAGING_BIND_ADDRESS=127.0.0.1
AIRE_STAGING_PORT=8889
PAYROLL_STAGING_PORT=8890
DOCKER_CONTEXT=colima-aire-payroll-staging-v2
PULL_POLICY=always

AIRE_PUBLIC_URL=https://aire-staging-v2.shimizu-technology.com
AIRE_PUBLIC_HOST=aire-staging-v2.shimizu-technology.com
PAYROLL_PUBLIC_URL=https://payroll-staging-v2.shimizu-technology.com

AIRE_CLERK_ISSUER=https://replace-with-aire-test-instance.clerk.accounts.dev
AIRE_CLERK_JWKS_URL=https://replace-with-aire-test-instance.clerk.accounts.dev/.well-known/jwks.json
AIRE_STAGING_ADMIN_CLERK_ID=user_replace
PAYROLL_STAGING_ADMIN_CLERK_ID=user_replace
STAGING_ADMIN_EMAIL=lmshimizu@gmail.com

RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=8
