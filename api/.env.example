# Cornerstone Payroll - Environment Variables Template
# Copy to .env and fill in values

# ===================
# WorkOS Authentication
# ===================
WORKOS_CLIENT_ID=client_xxx
WORKOS_API_KEY=sk_test_xxx
WORKOS_REDIRECT_URI=http://localhost:5173/callback

# ===================
# Cloudflare R2 Storage (for pay stub PDFs)
# ===================
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=cornerstone-payroll
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ===================
# Database
# ===================
DATABASE_URL=postgres://localhost:5432/cornerstone_payroll_development

# ===================
# Rails
# ===================
RAILS_ENV=development
SECRET_KEY_BASE=dev-secret-key-change-in-production

# Toggle auth enforcement (set to "false" for local dev)
AUTH_ENABLED=true

# JWT configuration (defaults to SECRET_KEY_BASE if JWT_SECRET is unset)
JWT_SECRET=
JWT_ISSUER=cornerstone-payroll
DEFAULT_USER_ROLE=employee

# Optional: verify WorkOS session on every request
VERIFY_WORKOS_SESSION=false

# Frontend base URL for invitation links
FRONTEND_URL=http://localhost:5173

# Email (Resend)
RESEND_API_KEY=
MAILER_FROM_EMAIL=no-reply@cornerstone-payroll.com

# Development fallback user scoping (used when AUTH_ENABLED=false)
USER_ID=1
COMPANY_ID=1

# Comma-separated frontend origins for CORS (production)
# Example: https://payroll.example.com,https://admin.example.com
CORS_ORIGINS=

# Exact, comma-separated public HTTPS hostnames Payroll may contact for time
# imports. Required in production when an active time tracking source exists.
# Example: aire.example.com,cornerstone-tax.example.com
TIME_TRACKING_ALLOWED_HOSTS=

# Enforce SSL in production behind a proxy
FORCE_SSL=true

# Durable production services (development may override these)
ACTIVE_STORAGE_SERVICE=r2
USE_SOLID_CACHE=true
USE_SOLID_QUEUE=true
USE_SOLID_CABLE=true

# Verified in Clerk dashboard; production readiness fails closed unless true.
REQUIRE_MFA=true

# Per-IP API throttles. Tune from observed production traffic.
API_THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=20

# Comma-separated CIDRs for the reverse proxies that are allowed to supply the
# client IP chain. Use the exact Kamal/load-balancer network for production.
TRUSTED_PROXY_CIDRS=

# ===================
# Active Record Encryption (for SSN)
# ===================
# Generate with: rails db:encryption:init
# Then paste the 3 values below
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=your_primary_key_here
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=your_deterministic_key_here
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=your_salt_here

# Clerk Auth
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ===================
# Cornerstone Tax Sync (CPR-53)
# ===================
# POST endpoint on Cornerstone Tax service for payroll tax ingest
CST_INGEST_URL=
# Bearer token for authenticating with CST (optional)
CST_API_TOKEN=
# Shared secret for CST ingest endpoint (sent as X-Shared-Secret)
CST_SHARED_SECRET=
