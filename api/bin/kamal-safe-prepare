#!/usr/bin/env ruby
# frozen_string_literal: true

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

require "rubygems"
require "bundler/setup"
require_relative "../lib/kamal_migration_executor"

begin
  KamalMigrationExecutor.new.run!
rescue StandardError => error
  warn "Kamal safe preparation failed: #{error.message}"
  warn error.backtrace if ENV["VERBOSE"]
  exit 1
end
