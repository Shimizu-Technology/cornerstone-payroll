      "title={!sourceCoverageAcknowledged || !sourceCoverageReason.trim() ? 'Enter a reason and acknowledge the missing hours.' : undefined}",
      "onClick={() => { const pending = pendingCoverageActionRef.current; pendingCoverageActionRef.current = null; setSourceCoverageOpen(false); if (!pending || pending.companyId !== companyId || pending.payRunId !== payRunId || pending.generation !== commitRouteGenerationRef.current) return; const coverage: CoverageAcknowledgement = { source_coverage_reason: sourceCoverageReason.trim(), source_coverage_acknowledged: true }; if (pending.action === 'refresh') void handleRefreshSetup(pending.refreshScope, coverage); else void handleRunPayroll(coverage); }}"
    ]
  },
  {
    "tag": "Button",
